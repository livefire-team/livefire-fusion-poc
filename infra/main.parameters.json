{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "kvPermissionModel": {
      "value": "${KV_PERMISSION_MODEL=rbac}"
    },
    "orderImage": {
      "value": "${ORDER_IMAGE}"
    },
    "sqlAdminPassword": {
      "value": "${SQL_ADMIN_PASSWORD}"
    },
    "principalType": {
      "value": "${AZURE_PRINCIPAL_TYPE=User}"
    },
    "refreshSeconds": {
      "value": "${SECRET_REFRESH_SECONDS=10}"
    },
    "denyBroadPolicy": {
      "value": "${DENY_BROAD_POLICY=off}"
    },
    "broadAttemptRole": {
      "value": "${BROAD_ATTEMPT_ROLE=off}"
    },
    "opsImage": {
      "value": "${OPS_IMAGE}"
    },
    "refereeImage": {
      "value": "${REFEREE_IMAGE}"
    },
    "evidenceRetentionDays": {
      "value": "${EVIDENCE_RETENTION_DAYS=1}"
    },
    "githubRepos": {
      "value": "${GITHUB_REPOS=livefire-team@349630330/livefire-fusion-poc@1437908536}"
    },
    "loadgenImage": {
      "value": "${LOADGEN_IMAGE}"
    },
    "loadgenDrillId": {
      "value": "${LOADGEN_DRILL_ID}"
    }
  }
}
