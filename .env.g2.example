# Examples only. DO NOT put real values/keys here or commit your filled-in .env.
# Development from WS4 root. Foundry and MCP values must come from the actual lab.
FOUNDRY_PROJECT_ENDPOINT=https://<foundry>.services.ai.azure.com/api/projects/proj-livefire
MODEL_DEPLOYMENT=<model-from-lab-probe>
MCP_URL=https://<ws3-mcp-host>
PLANNER_AGENT=lf-planner:<version>
ENGINEER_AGENT=lf-engineer:<version>
# Runtime GITHUB_REPO points at WS1, NOT the WS4 code repository.
GITHUB_REPO=livefire-team/livefire-fusion-poc
IMAGE_REPO=ghcr.io/livefire-team/order-service
BASE_REF=main
EVENT_SOURCE=dir:./evidence
# Ops and storage credentials must come from Key Vault / secure env at runtime.
# Never commit OPS_KEY, GitHub tokens, bearer tokens, private keys or MCP keys.
