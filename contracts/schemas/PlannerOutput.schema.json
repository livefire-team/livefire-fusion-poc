{
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "telemetry",
            "identity",
            "incident",
            "runbook",
            "repository",
            "commit",
            "referee",
            "ci"
          ],
          "title": "Source",
          "type": "string"
        },
        "ref": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Ref",
          "type": "string"
        },
        "note": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "source",
        "ref",
        "note"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "RecoveryOption": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "broad",
            "narrow"
          ],
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "action": {
          "enum": [
            "grant_contributor_subscription",
            "restore_kv_secrets_user"
          ],
          "title": "Action",
          "type": "string"
        },
        "risk": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Risk",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label",
        "action",
        "risk",
        "evidence"
      ],
      "title": "RecoveryOption",
      "type": "object"
    },
    "RecoveryOptions": {
      "additionalProperties": false,
      "description": "The Planner's first output: what broke and how it could be restored.",
      "properties": {
        "drill_id": {
          "pattern": "^drill-[A-Za-z0-9-]{1,64}$",
          "title": "Drill Id",
          "type": "string"
        },
        "hypothesis": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Hypothesis",
          "type": "string"
        },
        "rejected_hypotheses": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "title": "Rejected Hypotheses",
          "type": "array"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/RecoveryOption"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Options",
          "type": "array"
        },
        "recommended": {
          "enum": [
            "broad",
            "narrow"
          ],
          "title": "Recommended",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "drill_id",
        "hypothesis",
        "rejected_hypotheses",
        "confidence",
        "options",
        "recommended",
        "evidence"
      ],
      "title": "RecoveryOptions",
      "type": "object"
    },
    "RemediationBrief": {
      "additionalProperties": false,
      "description": "The Planner's output after a False Green; the Engineer's complete handoff (blueprint 5.2).",
      "properties": {
        "incident_id": {
          "pattern": "^drill-[A-Za-z0-9-]{1,64}$",
          "title": "Incident Id",
          "type": "string"
        },
        "evidence_references": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "maxItems": 12,
          "minItems": 2,
          "title": "Evidence References",
          "type": "array"
        },
        "supported_hypothesis": {
          "maxLength": 800,
          "minLength": 1,
          "title": "Supported Hypothesis",
          "type": "string"
        },
        "rejected_hypotheses": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "title": "Rejected Hypotheses",
          "type": "array"
        },
        "affected_components": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Affected Components",
          "type": "array"
        },
        "required_behavior": {
          "maxLength": 800,
          "minLength": 1,
          "title": "Required Behavior",
          "type": "string"
        },
        "acceptance_criteria": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Acceptance Criteria",
          "type": "array"
        },
        "allowed_repository_paths": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Allowed Repository Paths",
          "type": "array"
        },
        "prohibited_changes": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Prohibited Changes",
          "type": "array"
        },
        "residual_risks": {
          "items": {
            "type": "string"
          },
          "maxItems": 6,
          "title": "Residual Risks",
          "type": "array"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "incident_id",
        "evidence_references",
        "supported_hypothesis",
        "rejected_hypotheses",
        "affected_components",
        "required_behavior",
        "acceptance_criteria",
        "allowed_repository_paths",
        "prohibited_changes",
        "residual_risks",
        "confidence"
      ],
      "title": "RemediationBrief",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One schema for both Planner passes, so one Foundry agent serves both. Exactly one part is filled.",
  "properties": {
    "stage": {
      "enum": [
        "options",
        "brief"
      ],
      "title": "Stage",
      "type": "string"
    },
    "recovery_options": {
      "anyOf": [
        {
          "$ref": "#/$defs/RecoveryOptions"
        },
        {
          "type": "null"
        }
      ]
    },
    "remediation_brief": {
      "anyOf": [
        {
          "$ref": "#/$defs/RemediationBrief"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "stage",
    "recovery_options",
    "remediation_brief"
  ],
  "title": "PlannerOutput",
  "type": "object"
}
