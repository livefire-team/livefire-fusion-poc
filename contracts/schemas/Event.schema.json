{
  "additionalProperties": false,
  "description": "One line of evidence/<drill_id>/events.jsonl. Every writer uses exactly these five keys.",
  "properties": {
    "ts": {
      "title": "Ts",
      "type": "string"
    },
    "drill_id": {
      "pattern": "^drill-[A-Za-z0-9-]{1,64}$",
      "title": "Drill Id",
      "type": "string"
    },
    "action": {
      "pattern": "^[a-z]+(\\.[a-z_-]+)?$",
      "title": "Action",
      "type": "string"
    },
    "result": {
      "maxLength": 40,
      "title": "Result",
      "type": "string"
    },
    "details": {
      "additionalProperties": true,
      "title": "Details",
      "type": "object"
    }
  },
  "required": [
    "ts",
    "drill_id",
    "action",
    "result"
  ],
  "title": "Event",
  "type": "object"
}
