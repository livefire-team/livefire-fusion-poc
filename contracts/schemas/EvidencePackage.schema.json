{
  "$defs": {
    "AutonomyPolicy": {
      "additionalProperties": false,
      "description": "Chosen before the drill and evaluated outside the model. Production and merge never appear here.",
      "properties": {
        "version": {
          "default": "policy-1",
          "title": "Version",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/Mode",
          "default": "Supervised"
        },
        "preauthorized_actions": {
          "items": {
            "enum": [
              "restore_kv_secrets_user",
              "deploy_candidate_to_twin"
            ],
            "type": "string"
          },
          "title": "Preauthorized Actions",
          "type": "array"
        },
        "min_confidence": {
          "default": 0.6,
          "maximum": 1,
          "minimum": 0,
          "title": "Min Confidence",
          "type": "number"
        },
        "prove_durable": {
          "default": true,
          "title": "Prove Durable",
          "type": "boolean"
        },
        "budgets": {
          "$ref": "#/$defs/Budgets"
        },
        "expires_at": {
          "title": "Expires At",
          "type": "string"
        }
      },
      "required": [
        "expires_at"
      ],
      "title": "AutonomyPolicy",
      "type": "object"
    },
    "Budgets": {
      "additionalProperties": false,
      "properties": {
        "max_candidate_attempts": {
          "default": 2,
          "maximum": 2,
          "minimum": 1,
          "title": "Max Candidate Attempts",
          "type": "integer"
        },
        "max_tool_calls_per_agent_call": {
          "default": 25,
          "maximum": 60,
          "minimum": 1,
          "title": "Max Tool Calls Per Agent Call",
          "type": "integer"
        },
        "max_tokens": {
          "default": 400000,
          "minimum": 10000,
          "title": "Max Tokens",
          "type": "integer"
        },
        "max_drill_s": {
          "default": 5400,
          "minimum": 300,
          "title": "Max Drill S",
          "type": "integer"
        },
        "wait_s": {
          "default": 1800,
          "minimum": 60,
          "title": "Wait S",
          "type": "integer"
        },
        "approval_timeout_s": {
          "default": 900,
          "minimum": 30,
          "title": "Approval Timeout S",
          "type": "integer"
        },
        "ci_timeout_s": {
          "default": 900,
          "minimum": 60,
          "title": "Ci Timeout S",
          "type": "integer"
        },
        "agent_timeout_s": {
          "default": 600,
          "minimum": 30,
          "title": "Agent Timeout S",
          "type": "integer"
        }
      },
      "title": "Budgets",
      "type": "object"
    },
    "DebtItem": {
      "additionalProperties": false,
      "description": "v1.1: one operational-debt finding (blueprint 2.2). Composed by the workflow, never by a model.",
      "properties": {
        "kind": {
          "enum": [
            "application-resilience",
            "regression-coverage",
            "runbook",
            "knowledge"
          ],
          "title": "Kind",
          "type": "string"
        },
        "finding": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Finding",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "artifact": {
          "maxLength": 300,
          "title": "Artifact",
          "type": "string"
        },
        "residual_risk": {
          "maxLength": 400,
          "title": "Residual Risk",
          "type": "string"
        },
        "status": {
          "enum": [
            "candidate",
            "proposed",
            "recorded",
            "unresolved"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "finding",
        "evidence_refs",
        "artifact",
        "residual_risk",
        "status"
      ],
      "title": "DebtItem",
      "type": "object"
    },
    "Mode": {
      "enum": [
        "Advisory",
        "Supervised",
        "Autonomous Twin"
      ],
      "title": "Mode",
      "type": "string"
    },
    "Scorecard": {
      "additionalProperties": false,
      "description": "v1.1, blueprint 1.6: computed only from events.jsonl (including WS1's metrics.orders).",
      "properties": {
        "target_recovery_s": {
          "title": "Target Recovery S",
          "type": "integer"
        },
        "verified_recovery_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Verified Recovery S"
        },
        "false_green_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "False Green S"
        },
        "failed_orders": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Failed Orders"
        },
        "peak_backlog": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Peak Backlog"
        },
        "orders_per_min_before": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Orders Per Min Before"
        },
        "orders_per_min_after": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Orders Per Min After"
        },
        "decision_latency_s": {
          "title": "Decision Latency S",
          "type": "number"
        },
        "policy_denials": {
          "title": "Policy Denials",
          "type": "integer"
        },
        "durable_improvements": {
          "items": {
            "type": "string"
          },
          "title": "Durable Improvements",
          "type": "array"
        },
        "cost": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Cost",
          "type": "object"
        }
      },
      "required": [
        "target_recovery_s",
        "verified_recovery_s",
        "false_green_s",
        "failed_orders",
        "peak_backlog",
        "orders_per_min_before",
        "orders_per_min_after",
        "decision_latency_s",
        "policy_denials",
        "durable_improvements",
        "cost"
      ],
      "title": "Scorecard",
      "type": "object"
    },
    "Verdict": {
      "description": "Terminal states (blueprint A.7). Only the workflow sets one; no model can.",
      "enum": [
        "VERIFIED",
        "BASELINE_VERIFIED",
        "ABORTED_BASELINE",
        "ESCALATED_POLICY",
        "ESCALATED_EVIDENCE",
        "ESCALATED_SECURITY",
        "ESCALATED_BUDGET",
        "ESCALATED_DEPENDENCY",
        "KILLED"
      ],
      "title": "Verdict",
      "type": "string"
    },
    "VerdictInputs": {
      "additionalProperties": false,
      "description": "Blueprint 5.5. Every input is computed from events.jsonl alone, so anyone can recompute it.",
      "properties": {
        "authorized_action_completed": {
          "title": "Authorized Action Completed",
          "type": "boolean"
        },
        "policy_passed": {
          "title": "Policy Passed",
          "type": "boolean"
        },
        "technical_health_passed": {
          "title": "Technical Health Passed",
          "type": "boolean"
        },
        "ci_gates_passed": {
          "title": "Ci Gates Passed",
          "type": "boolean"
        },
        "journey_passed": {
          "title": "Journey Passed",
          "type": "boolean"
        },
        "persisted_order_assertion_passed": {
          "title": "Persisted Order Assertion Passed",
          "type": "boolean"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        }
      },
      "required": [
        "authorized_action_completed",
        "policy_passed",
        "technical_health_passed",
        "ci_gates_passed",
        "journey_passed",
        "persisted_order_assertion_passed"
      ],
      "title": "VerdictInputs",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "evidence/<drill_id>/package.json: the sealed summary of one drill (blueprint 8.1, A.9).",
  "properties": {
    "contract_version": {
      "default": "1.1",
      "title": "Contract Version",
      "type": "string"
    },
    "drill_id": {
      "pattern": "^drill-[A-Za-z0-9-]{1,64}$",
      "title": "Drill Id",
      "type": "string"
    },
    "scenario": {
      "title": "Scenario",
      "type": "string"
    },
    "terminal_state": {
      "$ref": "#/$defs/Verdict"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "verdict_inputs": {
      "anyOf": [
        {
          "$ref": "#/$defs/VerdictInputs"
        },
        {
          "type": "null"
        }
      ]
    },
    "policy": {
      "$ref": "#/$defs/AutonomyPolicy"
    },
    "agents": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Agents",
      "type": "object"
    },
    "prompt_sha256": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Prompt Sha256",
      "type": "object"
    },
    "model_deployment": {
      "title": "Model Deployment",
      "type": "string"
    },
    "base_ref": {
      "title": "Base Ref",
      "type": "string"
    },
    "candidate": {
      "additionalProperties": true,
      "title": "Candidate",
      "type": "object"
    },
    "options": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "title": "Options"
    },
    "brief": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "title": "Brief"
    },
    "counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Counts",
      "type": "object"
    },
    "usage": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Usage",
      "type": "object"
    },
    "timeline": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Timeline",
      "type": "object"
    },
    "events_sha256": {
      "title": "Events Sha256",
      "type": "string"
    },
    "events_count": {
      "title": "Events Count",
      "type": "integer"
    },
    "residual_risks": {
      "items": {
        "type": "string"
      },
      "title": "Residual Risks",
      "type": "array"
    },
    "scorecard": {
      "anyOf": [
        {
          "$ref": "#/$defs/Scorecard"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "operational_debt": {
      "items": {
        "$ref": "#/$defs/DebtItem"
      },
      "title": "Operational Debt",
      "type": "array"
    },
    "next_drill_recommendation": {
      "default": "",
      "title": "Next Drill Recommendation",
      "type": "string"
    }
  },
  "required": [
    "drill_id",
    "scenario",
    "terminal_state",
    "reason",
    "verdict_inputs",
    "policy",
    "agents",
    "prompt_sha256",
    "model_deployment",
    "base_ref",
    "candidate",
    "options",
    "brief",
    "counts",
    "usage",
    "timeline",
    "events_sha256",
    "events_count",
    "residual_risks"
  ],
  "title": "EvidencePackage",
  "type": "object"
}
