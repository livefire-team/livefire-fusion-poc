{
  "$defs": {
    "Budgets": {
      "additionalProperties": false,
      "properties": {
        "max_candidate_attempts": {
          "default": 2,
          "maximum": 2,
          "minimum": 1,
          "title": "Max Candidate Attempts",
          "type": "integer"
        },
        "max_tool_calls_per_agent_call": {
          "default": 25,
          "maximum": 60,
          "minimum": 1,
          "title": "Max Tool Calls Per Agent Call",
          "type": "integer"
        },
        "max_tokens": {
          "default": 400000,
          "minimum": 10000,
          "title": "Max Tokens",
          "type": "integer"
        },
        "max_drill_s": {
          "default": 5400,
          "minimum": 300,
          "title": "Max Drill S",
          "type": "integer"
        },
        "wait_s": {
          "default": 1800,
          "minimum": 60,
          "title": "Wait S",
          "type": "integer"
        },
        "approval_timeout_s": {
          "default": 900,
          "minimum": 30,
          "title": "Approval Timeout S",
          "type": "integer"
        },
        "ci_timeout_s": {
          "default": 900,
          "minimum": 60,
          "title": "Ci Timeout S",
          "type": "integer"
        },
        "agent_timeout_s": {
          "default": 600,
          "minimum": 30,
          "title": "Agent Timeout S",
          "type": "integer"
        }
      },
      "title": "Budgets",
      "type": "object"
    },
    "Mode": {
      "enum": [
        "Advisory",
        "Supervised",
        "Autonomous Twin"
      ],
      "title": "Mode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Chosen before the drill and evaluated outside the model. Production and merge never appear here.",
  "properties": {
    "version": {
      "default": "policy-1",
      "title": "Version",
      "type": "string"
    },
    "mode": {
      "$ref": "#/$defs/Mode",
      "default": "Supervised"
    },
    "preauthorized_actions": {
      "items": {
        "enum": [
          "restore_kv_secrets_user",
          "deploy_candidate_to_twin"
        ],
        "type": "string"
      },
      "title": "Preauthorized Actions",
      "type": "array"
    },
    "min_confidence": {
      "default": 0.6,
      "maximum": 1,
      "minimum": 0,
      "title": "Min Confidence",
      "type": "number"
    },
    "prove_durable": {
      "default": true,
      "title": "Prove Durable",
      "type": "boolean"
    },
    "budgets": {
      "$ref": "#/$defs/Budgets"
    },
    "expires_at": {
      "title": "Expires At",
      "type": "string"
    }
  },
  "required": [
    "expires_at"
  ],
  "title": "AutonomyPolicy",
  "type": "object"
}
